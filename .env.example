# Copy to .env.local and fill in from:
# Firebase console → Project settings → General → Your apps → Web app → SDK setup (Config)
# These are public client keys (they end up in the browser bundle anyway);
# access is protected by database.rules.json, not by keeping these secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Realtime Database URL, EU region looks like:
# https://<project-id>-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
